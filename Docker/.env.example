# Docker Compose Environment Variables
# Copy this file to .env in the Docker directory

# ====== Database Configuration ======
POSTGRES_DB=si3ln_db
POSTGRES_USER=si3ln_user
POSTGRES_PASSWORD=change-this-in-production

# ====== Django API Configuration ======
DEBUG=True
SECRET_KEY=dev-docker-secret-key-change-in-production
JWT_SECRET_KEY=dev-jwt-secret-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,api,frontend

# ====== Redis Configuration ======
# No additional config needed for Redis in development

# ====== Production Override ======
# For production, change DEBUG to False and set proper secrets:
# DEBUG=False
# SECRET_KEY=<generate-strong-random-key>
# JWT_SECRET_KEY=<generate-strong-random-key>
# POSTGRES_PASSWORD=<strong-password>
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
